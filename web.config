<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  ChiperX — IIS web.config (hosting Windows: SmarterASP/site4now)
  Diletakkan di ROOT website (sejajar index ini + folder public/).
  Tugasnya:
   1) File statis yang ADA di public/ (assets, favicon) → dilayani langsung
   2) Sisanya → public/index.php (front controller)
   3) URL asli tetap terbaca router via HTTP_X_ORIGINAL_URL
  ============================================================
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 1) File yang benar-benar ada di dalam public/ → layani langsung -->
        <rule name="ChiperX-StaticPublic" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions>
            <add input="{DOCUMENT_ROOT}\public\{R:1}" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="public/{R:1}" />
        </rule>

        <!-- 2) Semua request lain → front controller -->
        <rule name="ChiperX-FrontController" stopProcessing="true">
          <match url="^(.*)$" />
          <action type="Rewrite" url="public/index.php" />
        </rule>
      </rules>
    </rewrite>

    <!-- Naikkan batas upload (video 25 MB + form) → 60 MB.
         ⚠️ Bila muncul error 500.19 setelah upload file ini, hapus blok
         <security> ini (berarti section dikunci hosting; upload tetap
         jalan sampai batas default IIS 30 MB). -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="62914560" />
      </requestFiltering>
    </security>

    <!-- Jangan bocorkan daftar file -->
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
