# ============================================================
# ChiperX Environment Configuration
# ============================================================
APP_NAME="ChiperX"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://chiperx.example.com
APP_TIMEZONE=Asia/Jakarta
SESSION_NAME=CHIPERX_SESSION
SESSION_LIFETIME=28800

# ------------------------------------------------------------
# Database (MySQL 8 / MariaDB 10.6+)
# ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chiperx
DB_USER=chiperx_user
DB_PASS=ganti_password_kuat

# ------------------------------------------------------------
# SMTP Email (PHPMailer) — semua nilai ini juga bisa diedit dari
# web: Owner → Integrasi & API Keys (override DB mengalahkan .env).
#
# UNTUK COBA LOKAL TANPA SMTP: isi MAIL_DRIVER=log
# → OTP akan ditulis ke storage/logs/mail.log
#
# ── BREVO (direkomendasikan, gratis 300 email/hari) ──
#   brevo.com → SMTP & API → tab SMTP → Generate a new SMTP key
#   SMTP_USERNAME  = "Login" yang tampil di Brevo (biasanya email akun)
#   SMTP_PASSWORD  = SMTP key (xsmtpsib-…)
#   MAIL_FROM_ADDRESS WAJIB = email yang dipakai daftar Brevo!
# ------------------------------------------------------------
MAIL_DRIVER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_ENCRYPTION=auto
SMTP_USERNAME=emailanda@gmail.com
SMTP_PASSWORD=xsmtpsib-xxxxxxxx
MAIL_FROM_ADDRESS=emailanda@gmail.com
MAIL_FROM_NAME="ChiperX Official"
# Port alternatif bila 587 diblokir operator: 465 (SSL) atau 2525.
# SMTP_DEBUG=true → seluruh percakapan SMTP mentah direkam ke storage/logs/mail.log
SMTP_DEBUG=false
# ── GMAIL (alternatif): SMTP_HOST=smtp.gmail.com, PORT=587, ENCRYPTION=tls
#    PASSWORD = App Password 16 huruf (myaccount.google.com/apppasswords)
# ── MAILJET: SMTP_HOST=in-v3.mailjet.com, USERNAME=API Key, PASSWORD=Secret Key
#    MAIL_FROM_ADDRESS harus sender yang tervalidasi di Mailjet.
# ── KIRIM.EMAIL SMTP: SMTP_HOST=smtp.kirimemail.com, PORT=587, ENCRYPTION=tls
#    USERNAME = email domainmu (mis. otp@domainmu.com), PASSWORD = SMTP password dashboard

# ------------------------------------------------------------
# KIRIM.EMAIL Transactional API v4 (HTTPS port 443 — anti blokir
# port operator! Disarankan untuk Termux). Aktifkan dengan
# MAIL_DRIVER=kirimemail. Dashboard: app.kirim.email
# ------------------------------------------------------------
KIRIMEMAIL_API_KEY=key_xxxxxxxxxxxxxxxx
KIRIMEMAIL_API_SECRET=xxxxxxxx
KIRIMEMAIL_DOMAIN=domainkamu.com

# ------------------------------------------------------------
# Discord Webhook (Audit Log)
# ------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx
DISCORD_ENABLED=true

# ------------------------------------------------------------
# File Manager (absolute path; kosongkan = root project)
# ------------------------------------------------------------
FILEMANAGER_ROOT=
FILEMANAGER_MAX_EDIT_KB=2048

# ------------------------------------------------------------
# Payment Gateway (aktifkan salah satu: pakasir|duitku|tripay|midtrans|paydisini)
# Paling gampang untuk mulai: PAKASIR (cukup slug + api_key, QRIS langsung jalan)
# ------------------------------------------------------------
PAYMENT_DRIVER=pakasir

PAKASIR_SLUG=slug_project_pakasir_anda
PAKASIR_API_KEY=api_key_pakasir_anda

DUITKU_SANDBOX=true
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=

TRIPAY_SANDBOX=true
TRIPAY_API_KEY=isi_api_key_tripay
TRIPAY_PRIVATE_KEY=isi_private_key_tripay
TRIPAY_MERCHANT_CODE=isi_merchant_code

MIDTRANS_SANDBOX=true
MIDTRANS_SERVER_KEY=isi_server_key_midtrans
MIDTRANS_CLIENT_KEY=isi_client_key_midtrans

PAYDISINI_SANDBOX=true
PAYDISINI_API_KEY=isi_api_key_paydisini
